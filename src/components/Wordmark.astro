---
import { SITE_NAME } from '../lib/site';
import { LOGO } from '../lib/discipline';
const { label = SITE_NAME } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<a class="brand" href={base} aria-label={label}>
  <span class="logo" aria-hidden="true">{LOGO}</span>
  <span data-i18n="brand">{SITE_NAME}</span>
</a>
